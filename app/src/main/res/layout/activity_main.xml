<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="50dp"
    android:background="#263238">

    <LinearLayout
        android:id="@+id/layoutConfig"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:background="#37474F"
        android:elevation="4dp">

        <EditText
            android:id="@+id/editIp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:hint="IP (es. 192.168.1.5)"
            android:textColor="#FFFFFF"
            android:textColorHint="#B0BEC5"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/editPorta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Porta"
            android:textColor="#FFFFFF"
            android:textColorHint="#B0BEC5"
            android:inputType="number" />

        <Button
            android:id="@+id/btnConnetti"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OK"
            android:backgroundTint="#00E5FF"
            android:textColor="#263238" />
    </LinearLayout>

    <ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
        android:layout_below="@id/layoutConfig"
    android:layout_above="@id/pannelloControlli"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/campoDinamico"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="#455A64"
        android:padding="2dp"
        android:orientation="vertical" />
</ScrollView>

    <RelativeLayout
        android:id="@+id/pannelloControlli"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_alignParentBottom="true"
        android:background="#37474F"
        android:elevation="20dp">

        <FrameLayout
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_centerInParent="true">

            <Button
                android:id="@+id/btnUp"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="top|center_horizontal"
                android:backgroundTint="#2D2D2D"
                android:text="▲"
                android:textColor="#00D4FF" />

            <Button
                android:id="@+id/btnSx"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="left|center_vertical"
                android:backgroundTint="#2D2D2D"
                android:text="◀"
                android:textColor="#00D4FF" />

            <Button
                android:id="@+id/btnDx"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="right|center_vertical"
                android:backgroundTint="#2D2D2D"
                android:text="▶"
                android:textColor="#00D4FF" />

            <Button
                android:id="@+id/btnDown"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="bottom|center_horizontal"
                android:backgroundTint="#2D2D2D"
                android:text="▼"
                android:textColor="#00D4FF" />
        </FrameLayout>
    </RelativeLayout>
</RelativeLayout>